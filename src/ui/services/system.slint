export struct Temperature {
    label: string,
    celsius: float,
}

// Machine statistics, refreshed every two seconds.
export global System {
    // Utilisation in 0..1.
    in property <float> cpu;
    in property <[float]> cpu-cores;
    in property <float> memory;
    in property <float> swap;
    // Root filesystem.
    in property <float> disk;
    // Human readable, e.g. "5.2 GiB / 15.6 GiB".
    in property <string> memory-text;
    in property <string> disk-text;
    // The processor temperature in °C (the hottest plausible sensor without one), and all
    // sensors.
    in property <float> temperature;
    in property <[Temperature]> temperatures;
    // Bytes per second over physical interfaces, and as text ("1.2 MB/s").
    in property <float> download;
    in property <float> upload;
    in property <string> download-text;
    in property <string> upload-text;
    in property <string> hostname;
    in property <string> kernel;
    in property <string> os;
    // e.g. "3h 12m".
    in property <string> uptime;
    // The processor's model, cores, threads and highest clock ("4.6 GHz", empty when unknown).
    in property <string> processor;
    in property <int> processor-cores;
    in property <int> processor-threads;
    in property <string> processor-speed;
    // e.g. "x86_64".
    in property <string> architecture;
    // Installed packages and the package manager counting them, e.g. "1532 (pacman)".
    in property <string> packages;
    // e.g. "15.6 GiB".
    in property <string> memory-total;
    // Every graphics card ("NVIDIA GeForce RTX 3050") and its driver ("nvidia 620.70.06").
    in property <[string]> gpus;
    in property <[string]> gpu-drivers;
    // The first card that reports its state (NVIDIA through NVML, AMD): its load and video
    // memory in 0..1, temperature (°C), power (W) and clock (MHz), each 0 when unknown.
    // A sleeping card is not woken to ask.
    in property <bool> gpu-available;
    in property <float> gpu;
    in property <float> gpu-memory;
    in property <string> gpu-memory-text;
    in property <float> gpu-temperature;
    in property <float> gpu-power;
    in property <float> gpu-clock;
    // The last minute, oldest first: utilisation in 0..1, and the network traffic in 0..1 of
    // `network-peak` (bytes per second, also as text), the busiest moment in that minute.
    in property <[float]> cpu-history;
    in property <[float]> memory-history;
    in property <[float]> gpu-history;
    in property <[float]> download-history;
    in property <[float]> upload-history;
    in property <float> network-peak;
    in property <string> network-peak-text;
}

// The system battery, if any.
export global Battery {
    in property <bool> available;
    // Charge in 0..1.
    in property <float> level;
    in property <bool> charging;
    // "charging", "discharging", "full", "not-charging" or "unknown".
    in property <string> state;
    // Until empty or full, e.g. "1h 20m"; empty when unknown.
    in property <string> time-remaining;
}
